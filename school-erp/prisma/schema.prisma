// Vidyoday CBSE ERP - Multi-Tenant Production Prisma Schema
// Aligned with NEP 2020, NCrF, CBSE Examination Bylaws, UDISE+, and DPDP Act 2023

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. Multi-Tenant Organization & Campus Hierarchy
// -------------------------------------------------------------

model Tenant {
  id               String          @id @default(uuid())
  legalName        String          @map("legal_name")
  trustRegistrationNo String?      @map("trust_registration_no")
  subdomain        String          @unique
  planTier         String          @default("ENTERPRISE") @map("plan_tier")
  createdAt        DateTime        @default(now()) @map("created_at")
  campuses         Campus[]

  @@map("tenants")
}

model Campus {
  id                 String          @id @default(uuid())
  tenantId           String          @map("tenant_id")
  name               String
  code               String
  cbseAffiliationNo  String          @map("cbse_affiliation_no")
  udiseSchoolCode    String          @map("udise_school_code")
  address            String
  city               String
  state              String
  pincode            String
  trustAccountDetails Json           @map("trust_account_details") // Tally Prime / Escrow config
  fleetAccountDetails Json           @map("fleet_account_details")
  createdAt          DateTime        @default(now()) @map("created_at")

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students           Student[]
  staff              Staff[]
  feeHeads           FeeHead[]
  ledgerEntries      LedgerEntry[]
  buses              Bus[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("campuses")
}

// -------------------------------------------------------------
// 2. Student Master & Statutory Identity (UDISE+, APAAR, NCrF)
// -------------------------------------------------------------

enum ApaarConsentStatus {
  CONSENT_GRANTED
  CONSENT_PENDING
  REJECTED
  AADHAAR_MISMATCH
}

enum AcademicStage {
  FOUNDATIONAL   // Nursery - Class 2
  PREPARATORY    // Classes 3 - 5
  MIDDLE         // Classes 6 - 8
  SECONDARY      // Classes 9 - 12
}

model Student {
  id                     String             @id @default(uuid())
  campusId               String             @map("campus_id")
  admissionNumber        String             @map("admission_number")
  penNumber              String?            @map("pen_number") // UDISE+ Permanent Education Number
  apaarId                String?            @unique @map("apaar_id") // 12-Digit One Nation One Student ID
  apaarConsentStatus     ApaarConsentStatus @default(CONSENT_PENDING) @map("apaar_consent_status")
  
  // Demographics for UIDAI Demographic Scoring
  fullNameSchool         String             @map("full_name_school")
  fullNameAadhaar        String?            @map("full_name_aadhaar")
  dobSchool              DateTime           @map("dob_school")
  dobAadhaar             DateTime?          @map("dob_aadhaar")
  gender                 String
  bloodGroup             String?            @map("blood_group")
  category               String             @default("GEN") // GEN, OBC, SC, ST, EWS
  rteQuota               Boolean            @default(false) @map("rte_quota") // 25% RTE Free Seat
  
  fatherName             String             @map("father_name")
  motherName             String             @map("mother_name")
  primaryPhone           String             @map("primary_phone")
  primaryEmail           String?            @map("primary_email")
  
  currentClass           String             @map("current_class")
  section                String
  stage                  AcademicStage
  stream                 String?            // PCM, PCB, COMMERCE, HUMANITIES
  cbseSubjectCodes       String[]           @map("cbse_subject_codes") // e.g. ["301", "041", "042", "043", "083"]
  
  attendancePercentage   Decimal            @default(100.0) @db.Decimal(5, 2) @map("attendance_percentage")
  siblingGroupId         String?            @map("sibling_group_id")
  siblingDiscountRate    Decimal            @default(0.0) @db.Decimal(4, 2) @map("sibling_discount_rate")
  
  // Transport assignment
  busRouteId             String?            @map("bus_route_id")
  busStopName            String?            @map("bus_stop_name")
  rfidCardTagId          String?            @unique @map("rfid_card_tag_id")

  createdAt              DateTime           @default(now()) @map("created_at")

  campus                 Campus             @relation(fields: [campusId], references: [id])
  invoices               FeeInvoice[]
  ledgerEntries          LedgerEntry[]
  hpcRecords             NepHpcRecord[]
  rfidLogs               RfidTapRecord[]

  @@unique([campusId, admissionNumber])
  @@index([campusId, currentClass, section])
  @@index([apaarId])
  @@map("students")
}

// -------------------------------------------------------------
// 3. Double-Entry Fee Ledger & Split Settlement Accounting
// -------------------------------------------------------------

enum FeeCategory {
  TUITION
  ANNUAL
  TRANSPORT
  LAB_COMPUTER
  EXAMINATION
  SECURITY_DEPOSIT
}

enum SettlementTarget {
  TRUST_ACCOUNT
  FLEET_ACCOUNT
  CATERER_ACCOUNT
}

model FeeHead {
  id                 String           @id @default(uuid())
  campusId           String           @map("campus_id")
  code               String
  name               String
  category           FeeCategory
  targetSettlement   SettlementTarget @default(TRUST_ACCOUNT) @map("target_settlement")
  isRefundable       Boolean          @default(false) @map("is_refundable")
  
  campus             Campus           @relation(fields: [campusId], references: [id])
  invoiceItems       InvoiceItem[]

  @@unique([campusId, code])
  @@map("fee_heads")
}

model FeeInvoice {
  id                 String           @id @default(uuid())
  campusId           String           @map("campus_id")
  studentId          String           @map("student_id")
  invoiceNumber      String           @unique @map("invoice_number")
  quarter            String           // e.g. "2025-26-Q3"
  grossAmount        Decimal          @db.Decimal(12, 2) @map("gross_amount")
  concessionAmount   Decimal          @default(0.0) @db.Decimal(12, 2) @map("concession_amount")
  lateFine           Decimal          @default(0.0) @db.Decimal(12, 2) @map("late_fine")
  netPayable         Decimal          @db.Decimal(12, 2) @map("net_payable")
  amountPaid         Decimal          @default(0.0) @db.Decimal(12, 2) @map("amount_paid")
  status             String           @default("UNPAID") // UNPAID, PARTIAL, PAID, CONCESSION_PENDING
  dueDate            DateTime         @map("due_date")
  createdAt          DateTime         @default(now()) @map("created_at")

  student            Student          @relation(fields: [studentId], references: [id])
  items              InvoiceItem[]
  payments           FeeTransaction[]

  @@index([campusId, quarter, status])
  @@map("fee_invoices")
}

model InvoiceItem {
  id                 String           @id @default(uuid())
  invoiceId          String           @map("invoice_id")
  feeHeadId          String           @map("fee_head_id")
  amount             Decimal          @db.Decimal(12, 2)

  invoice            FeeInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead            FeeHead          @relation(fields: [feeHeadId], references: [id])

  @@map("invoice_items")
}

model LedgerEntry {
  id                 String           @id @default(uuid())
  campusId           String           @map("campus_id")
  studentId          String?          @map("student_id")
  transactionId      String?          @map("transaction_id")
  entryDate          DateTime         @default(now()) @map("entry_date")
  accountCode        String           @map("account_code") // e.g. "1010-CASH", "2010-TUITION-RECEIVABLE"
  accountName        String           @map("account_name")
  debitAmount        Decimal          @default(0.0) @db.Decimal(12, 2) @map("debit_amount")
  creditAmount       Decimal          @default(0.0) @db.Decimal(12, 2) @map("credit_amount")
  narration          String
  tallySyncStatus    String           @default("PENDING") @map("tally_sync_status")

  campus             Campus           @relation(fields: [campusId], references: [id])
  student            Student?         @relation(fields: [studentId], references: [id])

  @@index([campusId, accountCode, entryDate])
  @@map("ledger_entries")
}

model FeeTransaction {
  id                 String           @id @default(uuid())
  invoiceId          String           @map("invoice_id")
  receiptNumber      String           @unique @map("receipt_number")
  totalPaid          Decimal          @db.Decimal(12, 2) @map("total_paid")
  trustShare         Decimal          @db.Decimal(12, 2) @map("trust_share")
  fleetShare         Decimal          @db.Decimal(12, 2) @map("fleet_share")
  paymentMethod      String           @map("payment_method") // UPI, NET_BANKING, POS, CHEQUE
  gatewayRefNumber   String           @map("gateway_ref_number")
  settlementBatchId  String?          @map("settlement_batch_id")
  settledAt          DateTime?        @map("settled_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  invoice            FeeInvoice       @relation(fields: [invoiceId], references: [id])

  @@map("fee_transactions")
}

// -------------------------------------------------------------
// 4. Biometric Staffing & 7:30 AM Auto-Substitution Engine
// -------------------------------------------------------------

model Staff {
  id                 String           @id @default(uuid())
  campusId           String           @map("campus_id")
  employeeCode       String           @unique @map("employee_code")
  fullName           String           @map("full_name")
  phone              String
  email              String
  qualification      String
  subjectExpertise   String[]         @map("subject_expertise")
  stageCompetency    AcademicStage[]  @map("stage_competency")
  weeklySubLimit     Int              @default(3) @map("weekly_sub_limit")
  active             Boolean          @default(true)

  campus             Campus           @relation(fields: [campusId], references: [id])
  substitutionsGiven TeacherSubstitution[] @relation("SubstituteTeacher")

  @@map("staff")
}

model TeacherSubstitution {
  id                 String           @id @default(uuid())
  campusId           String           @map("campus_id")
  substituteStaffId  String           @map("substitute_staff_id")
  originalStaffId    String           @map("original_staff_id")
  date               DateTime         @db.Date
  periodNumber       Int              @map("period_number")
  className          String           @map("class_name")
  section            String
  subject            String
  status             String           @default("NOTIFIED") // NOTIFIED, ACKNOWLEDGED, COMPLETED
  smartboardPushedAt DateTime?        @map("smartboard_pushed_at")

  substituteStaff    Staff            @relation("SubstituteTeacher", fields: [substituteStaffId], references: [id])

  @@map("teacher_substitutions")
}

// -------------------------------------------------------------
// 5. NEP 2020 360-Degree Holistic Progress Card (HPC) & PARAKH
// -------------------------------------------------------------

model NepHpcRecord {
  id                 String           @id @default(uuid())
  studentId          String           @map("student_id")
  academicYear       String           @map("academic_year")
  stage              AcademicStage
  domainScoresJson   Json             @map("domain_scores_json") // PARAKH 5 domains + rubrics
  peerReviewJson     Json             @map("peer_review_json")
  parentReflectJson  Json             @map("parent_reflect_json")
  selfEvalJson       Json             @map("self_eval_json")
  notionalHours      Int              @default(1200) @map("notional_hours") // NCrF 1200 hrs
  ncrfCreditsEarned  Int              @default(40) @map("ncrf_credits_earned")
  teacherVoiceNotes  String?          @map("teacher_voice_notes")
  qrVerificationCode String           @unique @map("qr_verification_code")
  finalizedAt        DateTime?        @map("finalized_at")

  student            Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, academicYear])
  @@map("nep_hpc_records")
}

// -------------------------------------------------------------
// 6. AIS-140 GPS Transport & RFID Student Safety
// -------------------------------------------------------------

model Bus {
  id                 String           @id @default(uuid())
  campusId           String           @map("campus_id")
  registrationNumber String           @unique @map("registration_number")
  ais140ImeiNumber   String           @unique @map("ais140_imei_number")
  driverName         String           @map("driver_name")
  driverPhone        String           @map("driver_phone")
  routeCode          String           @map("route_code")
  capacity           Int              @default(45)

  campus             Campus           @relation(fields: [campusId], references: [id])
  taps               RfidTapRecord[]

  @@map("buses")
}

model RfidTapRecord {
  id                 String           @id @default(uuid())
  busId              String           @map("bus_id")
  studentId          String           @map("student_id")
  tapType            String           // "BOARDING" | "DEBOARDING"
  stopName           String           @map("stop_name")
  latitude           Decimal?         @db.Decimal(10, 6)
  longitude          Decimal?         @db.Decimal(10, 6)
  timestamp          DateTime         @default(now())
  whatsappAlertSent  Boolean          @default(false) @map("whatsapp_alert_sent")

  bus                Bus              @relation(fields: [busId], references: [id])
  student            Student          @relation(fields: [studentId], references: [id])

  @@index([studentId, timestamp])
  @@map("rfid_tap_records")
}
